[/mnt/vda2/etc/systemd/system/*cell*]
cat: '/mnt/vda2/etc/systemd/system/*cell*': No such file or directory
[/mnt/vda2/lib/systemd/system/celld.service]
[Unit]
Description=Cell daemon
After=containerd.service
After=vector.service
Requires=containerd.service
Requires=vector.service

[Service]
# convert symlink to real file to handle issues like #inc-2024-05-17-issues-connecting-to-mongodb-atlas-from-build-container
ExecStartPre=cp --remove-destination /proc/net/pnp /etc/resolv.conf
ExecStart=/opt/vercel/celld
ExecStopPost=/opt/vercel/celld-exit-hook.sh
Restart=no
Type=notify

# This is so containers started via runc do not inherit the default ulimit of
# celld. At the time of writing, we don't use the runc runtime under systemd in
# production. (We only use runc with celld as init). We also raise the limit
# here for completeness.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
