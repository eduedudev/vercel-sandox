# Reports metrics about all of Vector. We filter this
# later as it would lead to a lot of noise otherwise.
[sources.metrics_internal]
type = "internal_metrics"
namespace = "hive.vector"

[transforms.metrics_internal_filter]
type = "filter"
inputs = ["metrics_internal"]
condition = '''
  allowlist_metrics = [
    "buffer_discarded_events_total",
    "buffer_received_event_bytes_total",
    "buffer_received_events_total",
    "buffer_sent_event_bytes_total",
    "buffer_sent_events_total",
    "component_discarded_events_total",
    "component_errors_total",
    "component_received_bytes_total",
    "component_received_events_total",
    "component_sent_bytes_total",
    "component_sent_events_total"
  ]
  allowlist_components = [
    "cloudwatch_container",
    "kinesis",
  ]
  includes(allowlist_metrics, .name) && includes(allowlist_components, .tags.component_id)
'''

[transforms.metrics_tagged]
type = "remap"
inputs = [ "metrics_internal_filter" ]
source = '''
  .tags.service = "hive"
  .tags.hive = "true"
  .tags.env = "${HIVE_ID}"
  .tags.hive_realm = "${HIVE_REALM}"
  .tags.cell = "true"
'''
