===== celld-init.sh =====
#!/bin/sh

mount -t proc none /proc
mount -t sysfs none /sys
mount -t cgroup2 none /sys/fs/cgroup

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# convert symlink to real file to handle issues like #inc-2024-05-17-issues-connecting-to-mongodb-atlas-from-build-container
cp --remove-destination /proc/net/pnp /etc/resolv.conf

sysctl \
  fs.inotify.max_user_watches=524288 \
  kernel.pid_max=4194304 \
  net.ipv4.ping_group_range="0 2147483647" \
  kernel.core_uses_pid=1 \
  kernel.sysrq=16 \
  > /dev/null 2>&1

args=(--init)

for arg in $(</proc/cmdline); do
  case $arg in
    cell_id=*) args+=(--cell-id="${arg#cell_id=}") ;;
  esac
done

exec /opt/vercel/celld "${args[@]}"

===== celld-exit-hook.sh =====
#!/bin/env bash

set -euo pipefail

echo "Celld exit hook called."

# Give some time to journalctl to log everything
sleep 5

# Firecracker needs 'reboot' instead of 'shutdown' to stop the machine
systemctl reboot

===== apply-variables-vector.sh =====
#!/usr/bin/env bash

set -euo pipefail

# This is the default MMDS IP address which is set by firecracker.
mmds_ipv4_addr=169.254.169.254

# If a resources has empty string MMDS just leaves the connection open forever.
# Let's avoid that by setting the max-time.
curl_opts="--max-time 2 --silent --show-error --fail-with-body"

mmds_token=$(curl -X PUT "http://${mmds_ipv4_addr}/latest/api/token" -H "X-metadata-token-ttl-seconds: 60" $curl_opts)
mmds_data=$(curl "http://${mmds_ipv4_addr}" -H "Accept: application/json" -H "X-metadata-token: $mmds_token" $curl_opts)

mmds_get_value() {
  local key=$1
  local path=$2
  value=$(echo "$mmds_data" | jq --raw-output "$path")
  if [ -n "$value" ]; then
    echo "$value"
  else
    echo "'$key' is missing from MMDS store!"
    echo ""
  fi
}

disable_debug_logs() {
  cd /etc/vector
  rm -rf sources/kernel.toml
  rm -rf transforms/kernel_remap.toml
  rm -rf sinks/datadog_kernel.toml
}

datadog_api_key=$(mmds_get_value "datadog_api_key" '.credentials.datadog["api-key"]')
cell_id=$(mmds_get_value "cell_id" '."cell-id"')
hive_id=$(mmds_get_value "hive_id" '."hive-id"')
hive_realm=$(mmds_get_value "hive_realm" '."hive-realm"')
enable_debug_logs=$(mmds_get_value "debug_logs" '."debug-logs"')

if [ -n "$datadog_api_key" ]; then
  echo "DATADOG_API_KEY=$datadog_api_key" >> /etc/default/vector
fi


if [ -n "$cell_id" ]; then
  echo "CELL_ID=$cell_id" >> /etc/default/vector
fi


if [ -n "$hive_realm" ]; then
  echo "HIVE_REALM=$hive_realm" >> /etc/default/vector
fi

if [ -n "$hive_id" ]; then
  echo "HIVE_ID=$hive_id" >> /etc/default/vector
fi

if [[ $enable_debug_logs != "true" ]]; then
  disable_debug_logs
fi

build_version=$(awk -v RS=' ' -F= '/^build_version=/{print $2}' /proc/cmdline)
echo "BUILD_VERSION=${build_version:-unknown}" >> /etc/default/vector

